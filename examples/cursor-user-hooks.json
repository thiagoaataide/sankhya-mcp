{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node ./hooks/block-op-shell.cjs",
        "timeout": 10,
        "failClosed": true,
        "matcher": "op\\.exe|(^|[\\s;&|\\\\/'\"])op(\\s|$)|1password-cli|AgileBits\\.1Password|where\\s+op|Get-Command\\s+op"
      }
    ]
  }
}
